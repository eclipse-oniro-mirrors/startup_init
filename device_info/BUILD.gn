import("//base/startup/init/begetd.gni")
if (!defined(ohos_lite)) {
  import("//build/ohos.gni")
  import("//build/ohos/sa_profile/sa_profile.gni")

  ohos_sa_profile("device_info_profile") {
    sources = [ "etc/3902.json" ]
    part_name = "init"
  }

  ohos_prebuilt_etc("device_info.cfg") {
    source = "etc/deviceinfoservice.cfg"
    relative_install_dir = "init"
    part_name = "init"
    subsystem_name = "startup"
  }

  ohos_shared_library("deviceinfoservice") {
    sources = [
      "//base/startup/init/interfaces/innerkits/syspara/param_comm.c",
      "device_info_service.cpp",
    ]

    branch_protector_ret = "pac_ret"
    sanitize = {
      cfi = true
      cfi_cross_dso = true
      debug = false
    }

    shlib_type = "sa"

    include_dirs = [
      ".",
      "//base/startup/init/interfaces/innerkits/include",
      "//base/startup/init/interfaces/innerkits/include/param",
      "//base/startup/init/interfaces/innerkits/include/syspara",
      "//base/startup/init/interfaces/innerkits/syspara",
      "//base/startup/init/interfaces/hals",
    ]
    defines = [
      "INIT_AGENT",
      "_GNU_SOURCE",
      "USE_MBEDTLS",
      "DINFO_TAG=\"DeviceInfoService\"",
    ]
    # env config is PC-only, gated on init_feature_custom_sandbox. The
    # -DCUSTOM_SANDBOX cflag wraps env implementation in #ifdef; non-PC compiles
    # stubs returning SYSPARAM_PERMISSION_DENIED.
    if (init_feature_custom_sandbox) {
      cflags = [ "-DCUSTOM_SANDBOX" ]
    } else {
      cflags = []
    }
    deps = [
      "//base/startup/init/interfaces/innerkits:deviceinfo_stub",
      "//base/startup/init/interfaces/innerkits:libbegetutil",
      "//base/startup/init/services/log:agent_log",
      "//base/startup/init/services/modules/udid:libudidcomm",
      "//base/startup/init/services/utils:libinit_utils",
    ]

    external_deps = [
      "bounds_checking_function:libsec_shared",
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_single",
      "safwk:system_ability_fwk",
      "samgr:samgr_proxy",
    ]
    # access_token is used by both CheckPermission (UDID/Serial/DiskSN/BoardSerial
    # permission checks, always-on) and ResolveUserId (appenv GetHapTokenInfo,
    # CUSTOM_SANDBOX-gated). Do NOT tie it to init_feature_custom_sandbox — doing
    # so would silently break non-PC permission checks.
    if (defined(global_parts_info) &&
        defined(global_parts_info.security_access_token)) {
        external_deps += [ "access_token:libaccesstoken_sdk" ]
        defines += [ "INIT_SUPPORT_ACCESS_TOKEN" ]
    }
    if (defined(global_parts_info) &&
        defined(global_parts_info.hdf_drivers_interface_boardinfo)) {
        external_deps += [
          "drivers_interface_boardinfo:libboardinfo_proxy_1.0",
          "hdf_core:libhdf_utils",
        ]
        defines += [ "INIT_SUPPORT_BOARDINFO_HDI" ]
    }
    install_images = [ "system" ]
    part_name = "init"
    subsystem_name = "startup"
  }

  # appenv CLI is PC-only, compiled when init_feature_custom_sandbox is true.
  if (init_feature_custom_sandbox) {
    ohos_executable("appenv") {
      sources = [ "appenv.cpp" ]

      branch_protector_ret = "pac_ret"
      sanitize = {
        cfi = true
        cfi_cross_dso = true
        debug = false
      }

      include_dirs = [
        ".",
        "//base/startup/init/interfaces/innerkits/include",
      ]
      deps = [
        "//base/startup/init/interfaces/innerkits:libbeget_proxy",
      ]
      external_deps = [
        "c_utils:utils",
        "hilog:libhilog",
        "ipc:ipc_single",
        "samgr:samgr_proxy",
      ]
      install_images = [ "system" ]
      install_enable = true
      part_name = "init"
      subsystem_name = "startup"
    }
  }
}

group("device_info_group") {
  if (!defined(ohos_lite) && enable_ohos_startup_init_feature_deviceinfo) {
    deps = [
      ":device_info.cfg",
      ":device_info_profile",
      ":deviceinfoservice",
    ]
    # appenv CLI is PC-only (init_feature_custom_sandbox); non-PC products
    # do not build or install it.
    if (init_feature_custom_sandbox) {
      deps += [ ":appenv" ]
    }
  }
}
