# For now, it supports architechture of ['arm', 'arm64', 'riscv64'].

@privilegedProcessName
app_custom

@allowBlockList
setuid;arm64
setuid32;arm
setgid;arm64
setgid32;arm
setgroups;arm64
setgroups32;arm
setresgid;arm64
setresgid32;arm
settimeofday;all
sethostname;all
syslog;all
setreuid;arm64
setfsuid;arm64
setregid;arm64
setfsgid;arm64
reboot;arm64
setdomainname;arm64
clock_settime;arm64
acct;arm64
init_module;arm64
delete_module;arm64
finit_module;arm64
adjtimex;arm64
clock_adjtime;arm64
umount2;arm64
mount;arm64
chroot;arm64
swapon;arm64
swapoff;arm64
