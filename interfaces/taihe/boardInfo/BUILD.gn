import("//base/startup/init/begetd.gni")
import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
import("//build/ohos/taihe_idl/taihe.gni")

copy_taihe_idl("copy_boardInfo") {
  sources = [ "idl/ohos.boardInfo.taihe" ]
}
subsystem_name = "startup"
part_name = "init"
taihe_generated_file_path_boardInfo = "$taihe_file_path/out/$subsystem_name/$part_name/boardInfo"

ohos_taihe("run_taihe") {
  taihe_generated_file_path = "${taihe_generated_file_path_boardInfo}"
  deps = [ ":copy_boardInfo" ]
  outputs = [
    "$taihe_generated_file_path/src/ohos.boardInfo.ani.cpp",
    "$taihe_generated_file_path/src/ohos.boardInfo.abi.c",
  ]
}

taihe_shared_library("boardInfo_taihe_native") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  taihe_generated_file_path = "${taihe_generated_file_path_boardInfo}"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  sources = get_target_outputs(":run_taihe")
  sources += [
    "src/ani_constructor.cpp",
    "src/ohos.boardInfo.impl.cpp",
  ]
  deps = [
    ":run_taihe",
    "${init_innerkits_path}:libbeget_proxy",
    "${init_innerkits_path}:libbegetutil",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "ipc:ipc_single",
    "runtime_core:ani",
    "samgr:samgr_proxy",
  ]
}

generate_static_abc("boardInfo") {
  base_url = "$taihe_generated_file_path_boardInfo"
  files = [ "$taihe_generated_file_path_boardInfo/@ohos.boardInfo.ets" ]
  is_boot_abc = "True"
  device_dst_file = "/system/framework/boardInfo.abc"
  dependencies = [ ":run_taihe" ]
}

ohos_prebuilt_etc("boardInfo_etc") {
  source = "$target_out_dir/boardInfo.abc"
  module_install_dir = "framework"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  deps = [ ":boardInfo" ]
}
